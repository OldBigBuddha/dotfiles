[user]
	name = Shinra Yamakawa
	email = s.yamakawa@flatt.tech
	# signingkey / gpg.ssh.program are OS-specific; see ~/.config/git/local.inc
[fetch]
	prune = true
[core]
	ignorecase = false
	quotepath = false
	editor = nvim
[color]
	ui = true
	diff = auto
	status = auto
	branch = auto
[init]
	defaultBranch = main
# Include OS-specific config (ignored if file doesn't exist)
[include]
	path = ~/.config/git/local.inc
