{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(terraform fmt*)",
      "Bash(terraform init*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform output*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)"
    ],
    "deny": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform taint*)",
      "Bash(terraform untaint*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state rm*)",
      "Bash(terraform state push*)",
      "Bash(terraform force-unlock*)",
      "Bash(terraform workspace delete*)",
      "Bash(aws *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-sleep.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/warn-claude-md-size.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "flatt-devrel-skills@flatt-security-agent-skills": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "suberu@suberu": true,
    "flatt-development-skills@flatt-security-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "flatt-security-agent-skills": {
      "source": {
        "source": "github",
        "repo": "flatt-jp/agent-skills"
      }
    },
    "suberu": {
      "source": {
        "source": "directory",
        "path": "/Users/s.yamakawa/work_dir/suberu/claude"
      }
    }
  },
  "language": "日本語",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true
}
